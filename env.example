# Vercel Blob: crea un store en https://vercel.com/dashboard/stores
# y copia el token "Read and Write" del blob store al desplegar o en local.
# Con este token, además de subir fotos, se guarda una copia del catálogo en
# tyd/catalog.json para recuperarlo entre navegadores o si se borra el almacenamiento local.
BLOB_READ_WRITE_TOKEN=

# Panel /admin y subida de imágenes (/api/upload). Elige una clave larga y única.
ADMIN_PASSWORD=

# Mercado Pago
# ACCESS TOKEN privado (backend) y PUBLIC KEY pública (frontend)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# URL pública de la app para back_urls y webhook (ej: https://tyd-tu-equipo.vercel.app)
NEXT_PUBLIC_SITE_URL=
